# SolidJS Migration Environment Variables
REACT_APP_USE_SOLIDJS=false
REACT_APP_SOLIDJS_COMPONENTS=PersistentMetricCards
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true
REACT_APP_SOLIDJS_DEBUG=true

# Performance Thresholds
REACT_APP_PERFORMANCE_THRESHOLD_MS=16
REACT_APP_MEMORY_THRESHOLD_MB=50

# Migration Flags
REACT_APP_MIGRATE_TABLES=false
REACT_APP_MIGRATE_FILTERS=false
REACT_APP_MIGRATE_CHARTS=false