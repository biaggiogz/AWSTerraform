  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && npm run copy-wasm && ./scripts/setup-presigned-api.sh",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "transform": "node src/etl/transform_polars.js",
    "copy-wasm": "mkdir -p build/wasm && cp -r public/wasm/* build/wasm/ 2>/dev/null || true",
    "wasm:build": "echo 'WASM compilation would happen here - currently using JS fallbacks'",
    "sql-compiler:build": "./scripts/build-sql-compiler.sh",
    "sql-compiler:dev": "./scripts/build-sql-compiler.sh && npm start",
    "wasm:test": "node scripts/test-wasm-performance.js",
    "convert-csv": "node scripts/convert-csv-to-parquet.js",
    "generate-ssm": "node scripts/generate-ssm-csv.js",
    "prestart": "npm run generate-ssm"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
